# --- Database (Neon Postgres) ---
# Pooled connection (för queries via pgbouncer)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
# Direct connection (för migrations / db:push)
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# --- NextAuth (Auth.js v5) ---
# Generera: openssl rand -base64 32
AUTH_SECRET=""
# Lokalt: http://localhost:3000 — i Vercel sätts denna automatiskt till deploy-URL:n
AUTH_URL="http://localhost:3000"

# --- Email magic link (Resend) — frivilligt ---
AUTH_RESEND_KEY=""
EMAIL_FROM="Tyralife <noreply@tyra.life>"

# --- Google OAuth (frivilligt) ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Dev-only: sätt till din e-post för att kunna logga in via /api/dev-login
# utan Google OAuth. Routen svarar 404 om den inte är satt, och i prod.
DEV_LOGIN_EMAIL=

# --- Cloudflare R2 (Mood Board) ---
# Bucketen behöver CORS som tillåter PUT från appens domäner.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""
