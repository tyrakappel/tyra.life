// Tyra Life — Prisma schema
//
// Hierarki: User -> Board -> Section -> Subcategory -> Task
// `order` är Float så vi kan göra fraktionell omsortering (lexorank-stil)
// utan att skriva om hela listan vid drag-n-drop.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
// NextAuth (Auth.js v5) — Prisma adapter
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  boards     Board[]
  moodBoards MoodBoard[]
  moodItems  MoodItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Life Plan
// ============================================================

model Board {
  id        String   @id @default(cuid())
  userId    String
  name      String
  emoji     String?
  order     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections  Section[]
  snapshots BoardSnapshot[]
  lifeCurve LifeCurve?

  @@index([userId, order])
}

// ============================================================
// LifeCurve — användarens emotionella livskurva för boarden.
// En per board. Punkterna ligger var 0.5 år från 0 till nuvarande
// ålder, värden mellan -1 och 1 där 0 är neutralt.
// ============================================================

model LifeCurve {
  id        String   @id @default(cuid())
  boardId   String   @unique
  birthYear Int?
  values    Json // number[] — index*0.5 = ålder i år, value -1..1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

// ============================================================
// Snapshot — point-in-time bild av en boards hela innehåll.
// Möjliggör preview + rollback från header-dropdown.
// ============================================================

model BoardSnapshot {
  id        String   @id @default(cuid())
  boardId   String
  label     String? // valfri etikett, t.ex. "innan stora rensningen"
  reason    String? // auto-anledning: "manuell", "pre-restore", "auto"
  data      Json // sections + subcategories + tasks som JSON
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt(sort: Desc)])
}

model Section {
  id          String   @id @default(cuid())
  boardId     String
  title       String
  description String?
  color       String? // hex eller tailwind-key, frivilligt
  order       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board         Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]

  @@index([boardId, order])
}

model Subcategory {
  id          String   @id @default(cuid())
  sectionId   String
  title       String
  description String?
  order       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([sectionId, order])
}

model Task {
  id            String    @id @default(cuid())
  subcategoryId String
  title         String
  description   String?
  completed     Boolean   @default(false)
  completedAt   DateTime?
  order         Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@index([subcategoryId, completed, order])
}

// ============================================================
// Mood Board — flera boards per användare, bilder och videor, lagrade i Cloudflare R2.
// Placeringen sparas inte, den räknas fram ur ordningen i lib/mood-layout.ts
// så rymden alltid är tätt packad från mitten.
// ============================================================
model MoodBoard {
  id         String   @id @default(cuid())
  userId     String
  name       String
  emoji      String?
  order      Float    @default(0)
  /// Hemlig token för publik läslänk (/share/<token>). null = inte delad.
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MoodItem[]

  @@index([userId, order])
}

model MoodItem {
  id          String   @id @default(cuid())
  userId      String
  moodBoardId String
  /// "image" eller "video"
  kind        String   @default("image")
  key         String   @unique
  url         String
  /// stillbild för video, visas tills man hovrar
  posterKey   String?
  posterUrl   String?
  width       Int
  height      Int
  bytes       Int?
  /// SHA-256 av originalfilen, för att känna igen dubbletter per board
  contentHash String?
  /// 0 = långt bort, 1 = nära
  depth       Float
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodBoard MoodBoard @relation(fields: [moodBoardId], references: [id], onDelete: Cascade)

  @@unique([moodBoardId, contentHash])
  @@index([moodBoardId])
}
